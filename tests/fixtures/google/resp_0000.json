 ножницами",2,null,null,"2ahUKEwj29ZeylJ6YAxVY8LsIHWEzF8wQ3YcHKAF6BAgAEDc"],[["job_type_id:shape_up"],"Мужские стрижки с рисунком",2,null,null,"2ahUKEwj29ZeylJ6YAxVY8LsIHWEzF8wQ3YcHKAJ6BAgAEDg"]],[1]],null,"Услуги",null,"2ahUKEwj29ZeylJ6YAxVY8LsIHWEzF8wQ3IcHKAJ6BAgAEDU",null,null,null,null,null,3,null,2],[["LEGACY_SERVICES_USER_JOURNEY"],"Пользовались ли вы услугами этой компании?",[[[["E:YES"],"Да",2,null,null,"2ahUKEwj29ZeylJ6YAxVY8LsIHWEzF8wQ3YcHKAB6BAgAEDo"]],1],null,null,null,null,"2ahUKEwj29ZeylJ6YAxVY8LsIHWEzF8wQ3IcHKAN6BAgAEDk",null,null,null,null,null,4,null,2]],null,null,null,null,null,null,null,["ru"],[["Стригусь у Татьяны более 2-х лет. Очень нравится. Профессионально, качественно, быстро (время стрижки всего 30 минут). Приемлемые цены. 25-ти летний стаж даёт о себе знать. Чувствуется рука мастера. Хочется отметить, что Татьяна является именно мужским мастером, а не парикмахером- универсалом. На мой взгляд это весомое конкурентое преимущество. Поэтому всем рекомендую. Стоит прийти только раз, и больше нигде вам стричься не захочется. Вы останетесь довольны на все 100%. Также хочу добавить тот факт, что стригся ранее в других местах и каждый раз в стрижках мне что-то, да не нравилось. Но после первой стрижки у Татьяны я почувствовал колоссальную разницу и был приятно удивлен. Это был тот самый случай, когда меня подстригли, как и хотел. Так происходит и по сей день, что не может не радовать. В общем если вы хотите четкую стрижку - тогда вам к Татьяне!",null,[0,237]]]],[null,1635790152000000,1635790152000000,"5 лет назад",["https://www.google.com/local/content/rap/report?postId\u003d5@1:CAEQrcz1_gkiGwoZQ0hfQUFWR2FhMEtIYzFrWUdhWkFBVG9mdw%7CCAEQrcz1_gkiMAoZQ0hfQUFWR2FhMEtIYzFrWUdhWkFBVG9mdxoTQ2d3SXlOcUFqQVlRLUtpT3BBSQ\u0026d\u003d286732320\u0026t\u003d7\u0026wv\u003d1",null,null,"2ahUKEwj29ZeylJ6YAxVY8LsIHWEzF8wQ_2MoBHoECAAQOw"],"https://business.google.com/local/business/9464058643221968732/customers/reviews/reply?p\u003dCiRDaGREU1VoTk1HOW5TMFZKUTBGblNVTkhj